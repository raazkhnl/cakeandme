# ─── Firebase (client) ────────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ─── Admin gate (comma-separated emails) ──────────────────────────
NEXT_PUBLIC_ADMIN_EMAILS=youremail@example.com

# ─── Payments — Khalti ────────────────────────────────────────────
# Public key isn't used by the server flow but kept for reference.
NEXT_PUBLIC_KHALTI_PUBLIC_KEY=
# Secret key is consumed only by the API routes (server-only).
KHALTI_SECRET_KEY=
KHALTI_LIVE=false

# ─── Payments — eSewa ─────────────────────────────────────────────
NEXT_PUBLIC_ESEWA_MERCHANT_CODE=EPAYTEST
NEXT_PUBLIC_ESEWA_LIVE=false

# ─── Site / brand ─────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://cakesbyratna.vercel.app
NEXT_PUBLIC_BRAND_PHONE=+9779863244500
NEXT_PUBLIC_BRAND_EMAIL=cakebyratna@gmail.com
NEXT_PUBLIC_BRAND_FB=https://www.facebook.com/cakebyratna
