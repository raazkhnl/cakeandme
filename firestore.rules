rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    // Catalogue — public read, admin write
    match /products/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /categories/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /settings/{doc=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Users — owner read/write; admin read
    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow update: if isSignedIn() &&
        request.auth.uid == uid &&
        // can't elevate self to admin
        (!('role' in request.resource.data) || request.resource.data.role == resource.data.role || isAdmin());
      allow delete: if isAdmin();
    }

    // Orders — tracking by code is public read; create open to all (guest checkout);
    // update only by owner or admin
    match /orders/{code} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin() ||
        (isSignedIn() && resource.data.uid == request.auth.uid);
    }

    // Reviews — public read of approved; create by anyone; moderation by admin
    match /products/{pid}/reviews/{rid} {
      allow read: if resource.data.approved == true || isAdmin() ||
        (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if true; // captcha + admin moderation gate spam at the UI layer
      allow update, delete: if isAdmin();
    }

    // Coupons — admin only
    match /coupons/{code} {
      allow read: if true;     // validate at checkout
      allow write: if isAdmin();
    }

    // Newsletter — anyone can subscribe; only admin reads
    match /newsletter/{email} {
      allow read: if isAdmin();
      allow create: if true;
      allow delete: if isAdmin();
    }

    // Contact messages — anyone can submit; admin reads
    match /messages/{id} {
      allow read, update, delete: if isAdmin();
      allow create: if true;
    }
  }
}
